{
  "name": "ornament",
  "description": "Self-hosted Secret Santa for family and friends.",
  "version": "0.10.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {"node": ">=24.4.0"},
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "import-history": "node --env-file-if-exists=.env scripts/import-history.js"
  },
  "dependencies": {"express": "5.3.0", "nodemailer": "10.1.0"}
}
